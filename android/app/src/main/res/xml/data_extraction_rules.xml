<?xml version="1.0" encoding="utf-8"?>
<!-- Хмарний бекап і перенесення між пристроями вимкнені повністю:
     дані користувача не залишають пристрій (тех. спека п.5.2). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
